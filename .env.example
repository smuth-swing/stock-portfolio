# Microsoft Graph API 설정 파일
# 이 파일을 .env로 이름 변경하고 값을 입력하세요

# Azure AD 테넌트 ID (조직 ID)
# 기본값: common (개인 계정용)
TENANT_ID=common

# Azure 애플리케이션 클라이언트 ID
CLIENT_ID=your-client-id-here

# Azure 애플리케이션 클라이언트 시크릿
CLIENT_SECRET=your-client-secret-here

# 인증 리디렉트 URI (Azure 앱 등록에서 설정한 값과 동일)
# 기본값: http://localhost:5000/auth/callback
REDIRECT_URI=http://localhost:5000/auth/callback
